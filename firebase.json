{
  "firestore": {
    "rules": "firestore.rules",
    "indexes": "firestore.indexes.json"
  },
  "functions": [
    {
      "source": "functions",
      "codebase": "default",
      "ignore": [
        "node_modules",
        ".git"
      ]
    }
  ],
  "flutter": {
    "platforms": {
      "android": {
        "default": {
          "projectId": "iping-share",
          "appId": "1:174626795612:android:157df9f21690777dd63699",
          "fileOutput": "android/app/google-services.json"
        }
      },
      "ios": {
        "default": {
          "projectId": "iping-share",
          "appId": "1:174626795612:ios:9e5b3c5ded0c7effd63699",
          "uploadDebugSymbols": false,
          "fileOutput": "ios/Runner/GoogleService-Info.plist"
        }
      },
      "dart": {
        "lib/firebase_options.dart": {
          "projectId": "iping-share",
          "configurations": {
            "android": "1:174626795612:android:157df9f21690777dd63699",
            "ios": "1:174626795612:ios:9e5b3c5ded0c7effd63699"
          }
        }
      }
    }
  },
  "storage": {
    "rules": "storage.rules"
  }
}
