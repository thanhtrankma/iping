rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function isMember(gid) {
      return signedIn()
        && request.auth.uid in get(/databases/$(database)/documents/groups/$(gid)).data.memberIds;
    }

    function isNumber(v) {
      return v is int || v is float;
    }

    // Chuỗi dài từ lo tới hi ký tự. (Lưu ý: `s.size() in [lo, hi]` là kiểm tra thuộc danh sách,
    // tức chỉ đúng khi dài đúng lo hoặc hi ký tự.)
    function lenIn(s, lo, hi) {
      return s is string && s.size() >= lo && s.size() <= hi;
    }

    // Hồ sơ người dùng: chỉ chính chủ đọc/ghi (chứa token push).
    match /users/{uid} {
      allow read, write: if signedIn() && request.auth.uid == uid;

      // Ô lục giác đã khám phá, chia theo bucket.
      match /explore/{bucket} {
        allow read, write: if signedIn() && request.auth.uid == uid;
      }
    }

    // Mã mời chỉ được Cloud Functions truy cập.
    // Chat 1-1: dms/{uidA_uidB} (uid xếp tăng dần). Chỉ tạo được khi cả hai cùng ở trong `groupId`.
    function dmMembers(dmId) {
      return get(/databases/$(database)/documents/dms/$(dmId)).data.members;
    }
    match /dms/{dmId} {
      // resource == null: cho phép kiểm tra cuộc trò chuyện đã tồn tại chưa.
      allow read: if signedIn() && (resource == null || request.auth.uid in resource.data.members);
      allow create: if signedIn()
        && request.resource.data.members is list
        && request.resource.data.members.size() == 2
        && request.auth.uid in request.resource.data.members
        && request.resource.data.members[0] < request.resource.data.members[1]
        && dmId == request.resource.data.members[0] + '_' + request.resource.data.members[1]
        && request.resource.data.groupId is string
        && request.resource.data.members[0] in get(/databases/$(database)/documents/groups/$(request.resource.data.groupId)).data.memberIds
        && request.resource.data.members[1] in get(/databases/$(database)/documents/groups/$(request.resource.data.groupId)).data.memberIds;
      allow update: if signedIn() && request.auth.uid in resource.data.members
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['lastText', 'lastUid', 'lastAt']);

      match /messages/{mid} {
        allow read: if signedIn() && request.auth.uid in dmMembers(dmId);
        allow create: if signedIn() && request.auth.uid in dmMembers(dmId)
          && request.resource.data.uid == request.auth.uid
          && request.resource.data.text is string
          && lenIn(request.resource.data.text, 1, 1000);
      }
    }

    match /inviteCodes/{code} {
      allow read, write: if false;
    }

    match /groups/{gid} {
      allow read: if signedIn() && request.auth.uid in resource.data.memberIds;
      // Tạo / tham gia / rời nhóm đi qua Cloud Functions.
      allow create, delete: if false;
      // Chủ nhóm được đổi tên nhóm.
      allow update: if signedIn()
        && request.auth.uid == resource.data.ownerId
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name'])
        && request.resource.data.name is string
        && lenIn(request.resource.data.name, 1, 50);

      // Mỗi thành viên chỉ ghi được vị trí của chính mình.
      match /locations/{uid} {
        allow read: if isMember(gid);
        allow write: if isMember(gid) && request.auth.uid == uid;

        // Lịch sử vị trí: thành viên đọc được, chỉ chính chủ ghi.
        match /points/{pid} {
          allow read: if isMember(gid);
          allow create: if isMember(gid) && request.auth.uid == uid
            && isNumber(request.resource.data.lat)
            && isNumber(request.resource.data.lng)
            && request.resource.data.t is timestamp;
          allow delete: if isMember(gid) && request.auth.uid == uid;
        }
      }

      // Ping nhanh giữa hai thành viên.
      match /pings/{pid} {
        allow read: if isMember(gid)
          && (resource.data.to == request.auth.uid || resource.data.from == request.auth.uid);
        allow create: if isMember(gid)
          && request.resource.data.from == request.auth.uid
          && request.resource.data.to in get(/databases/$(database)/documents/groups/$(gid)).data.memberIds
          && request.resource.data.type in ['love', 'boo', 'poke', 'arrived', 'call', 'home', 'locate'];
      }

      // Khoảnh khắc: ảnh/trạng thái kèm vị trí, tự hết hạn sau 24 giờ.
      match /moments/{mid} {
        allow read: if isMember(gid);
        allow create: if isMember(gid)
          && request.resource.data.uid == request.auth.uid
          && request.resource.data.text is string
          && request.resource.data.text.size() <= 300
          && request.resource.data.likes == [];
        // Thành viên chỉ được thả/bỏ tim của chính mình.
        allow update: if isMember(gid)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['likes'])
          && request.resource.data.likes.toSet().difference(resource.data.likes.toSet())
               .union(resource.data.likes.toSet().difference(request.resource.data.likes.toSet()))
               .hasOnly([request.auth.uid]);
        allow delete: if isMember(gid) && resource.data.uid == request.auth.uid;
      }

      // Meetup: điểm hẹn của nhóm.
      match /meetups/{mid} {
        allow read: if isMember(gid);
        allow create: if isMember(gid)
          && request.resource.data.createdBy == request.auth.uid
          && request.resource.data.title is string
          && lenIn(request.resource.data.title, 1, 80)
          && isNumber(request.resource.data.lat)
          && isNumber(request.resource.data.lng)
          && request.resource.data.time is timestamp;
        // Người tạo sửa được mọi thứ; người khác chỉ cập nhật trạng thái của mình.
        allow update: if isMember(gid) && (
          resource.data.createdBy == request.auth.uid
          || (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['participants'])
              && request.resource.data.participants.diff(resource.data.participants)
                   .affectedKeys().hasOnly([request.auth.uid])));
        allow delete: if isMember(gid) && resource.data.createdBy == request.auth.uid;
      }

      match /places/{pid} {
        allow read, delete: if isMember(gid);
        allow create, update: if isMember(gid)
          && request.resource.data.name is string
          && lenIn(request.resource.data.name, 1, 60)
          && isNumber(request.resource.data.lat)
          && isNumber(request.resource.data.lng)
          && isNumber(request.resource.data.radius)
          && request.resource.data.radius >= 50
          && request.resource.data.radius <= 5000;
      }

      match /events/{eid} {
        allow read: if isMember(gid);
        allow create: if isMember(gid)
          && request.resource.data.uid == request.auth.uid
          && request.resource.data.type in ['arrive', 'leave', 'sos', 'meetup_arrive', 'low_battery', 'checkin', 'location_off', 'speeding',
                                         'safe_start', 'safe_arrive', 'safe_end', 'safe_ok', 'safe_extend']
          // Cảnh báo pin yếu phải kèm mức pin hợp lệ.
          && (request.resource.data.type != 'low_battery'
              || (request.resource.data.battery is int
                  && request.resource.data.battery >= 0
                  && request.resource.data.battery <= 100))
          // Chạy quá tốc độ phải kèm tốc độ hợp lệ (km/h).
          && (request.resource.data.type != 'speeding'
              || (request.resource.data.speed is int
                  && request.resource.data.speed > 80
                  && request.resource.data.speed <= 400));
      }

      // Về an toàn: mỗi người một chuyến (doc id = uid). Chỉ server đánh dấu quá giờ
      // (status 'overdue', alerts > 0); người đi chỉ được đặt lại alerts về 0 khi gia hạn.
      match /safeTrips/{uid} {
        allow read: if isMember(gid);
        allow create, update: if isMember(gid) && request.auth.uid == uid
          && request.resource.data.destName is string
          && lenIn(request.resource.data.destName, 1, 120)
          && isNumber(request.resource.data.destLat)
          && isNumber(request.resource.data.destLng)
          && isNumber(request.resource.data.radius)
          && request.resource.data.radius >= 50
          && request.resource.data.radius <= 2000
          && request.resource.data.dueAt is timestamp
          && request.resource.data.status in ['active', 'arrived', 'ended']
          && (request.resource.data.get('alerts', 0) == 0
              || (resource != null && request.resource.data.alerts == resource.data.get('alerts', 0)));
        allow delete: if isMember(gid) && request.auth.uid == uid;
      }

      // Điểm khám phá: thành viên đọc được, mỗi người chỉ ghi điểm của mình.
      match /explore/{uid} {
        allow read: if isMember(gid);
        allow create, update: if isMember(gid) && request.auth.uid == uid
          && request.resource.data.count is int
          && request.resource.data.count >= 0
          && isNumber(request.resource.data.areaKm2);
        allow delete: if isMember(gid) && request.auth.uid == uid;
      }

      match /messages/{mid} {
        allow read: if isMember(gid);
        allow create: if isMember(gid)
          && request.resource.data.uid == request.auth.uid
          && request.resource.data.text is string
          && lenIn(request.resource.data.text, 1, 1000);
      }
    }
  }
}
