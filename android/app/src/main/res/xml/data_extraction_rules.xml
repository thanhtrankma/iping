<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+: không sao lưu lên đám mây và không chuyển sang máy mới dữ liệu của IPing
     (phiên đăng nhập, lựa chọn chia sẻ theo nhóm, bộ nhớ đệm vị trí). Đăng nhập lại là đủ. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" path="."/>
        <exclude domain="file" path="."/>
        <exclude domain="database" path="."/>
        <exclude domain="sharedpref" path="."/>
        <exclude domain="external" path="."/>
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" path="."/>
        <exclude domain="file" path="."/>
        <exclude domain="database" path="."/>
        <exclude domain="sharedpref" path="."/>
        <exclude domain="external" path="."/>
    </device-transfer>
</data-extraction-rules>
